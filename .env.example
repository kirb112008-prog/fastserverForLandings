PORT=3000

# адрес лендинга (с https://), через пробел; нужен только для запросов из браузера
ALLOWED_URLS=https://example.ru https://www.example.ru

# токен для POST /postUserData: его знает только сервер сайта (wp-config.php), в браузер он не попадает
ACCESS_TOKEN=

# отдельный токен для GET /getUsers (выгрузка всех заявок): не использовать нигде, кроме вашего компьютера
ADMIN_TOKEN=

# база: облачная Turso или локальный файл на этом же сервере, например file:/var/lib/avito-server/app.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

GMAIL_USER=
GMAIL_APP_PASSWORD=

# почта: ящик на вашем домене (адрес SMTP-сервера и порт смотрите в панели почты хостинга)
# если не задано, используется Gmail (GMAIL_USER / GMAIL_APP_PASSWORD выше)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
